# HARBOUR·OS configuration
# Copy to .env for local development, or set as environment variables
# in your Portainer stack.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Shown in the sidebar and page header
CENTRE_NAME=Harbour Sailing Centre

# Your centre's position — drives the live weather panel (knotted wind,
# gusts, sea state). Find coordinates at openstreetmap.org.
CENTRE_LAT=50.7679
CENTRE_LON=-1.2977
CENTRE_TZ=Europe/London

# Set to "false" to skip automatic schema migrations on boot
# DB_MIGRATE=false
